{
  "name": "shingai-site",
  "version": "0.0.1",
  "private": true,
  "description": "Source for shingai.xyz, the personal site of Shingai Thornton. Astro and plain CSS.",
  "license": "SEE LICENSE IN LICENSE.md",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rsthornton/shingai-site.git"
  },
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "check:links": "node scripts/check-links.mjs",
    "format": "prettier --write .",
