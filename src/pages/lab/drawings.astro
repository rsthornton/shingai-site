---
// TEMPORARY (lab): every drawing in the library at once, grouped by lineage. Delete with src/art/ once one is chosen.
import BaseLayout from '../../layouts/BaseLayout.astro';
import Drawing from '../../art/Drawing.astro';
import { drawings } from '../../art/registry';

const lineages = [...new Set(drawings.map((d) => d.lineage))];
---

<BaseLayout title="Drawing library (lab)">
  <h1>Drawing library</h1>
  <p class="intro">
    {drawings.length} candidates for home, new drawings in the spirit of each source. Click one to try it on home, where
    ← and → flip through them.
  </p>
  {lineages.map((l) => (
    <section>
      <h2>{l}</h2>
      <ul>
        {drawings
          .filter((d) => d.lineage === l)
          .map((d) => (
            <li>
              <a href={`/?art=${d.id}`}>
                <span class="frame">
                  <Drawing id={d.id} />
                </span>
                <span class="t">{d.title}</span>
              </a>
              <p>{d.note}</p>
            </li>
          ))}
      </ul>
    </section>
  ))}
</BaseLayout>

<style>
  h1 {
    font: 600 2.4rem/1.15 var(--serif);
    margin: 0 0 8px;
  }
  .intro {
    color: var(--ink-2);
    margin-bottom: 32px;
  }
  h2 {
    font: 600 1.3rem var(--serif);
    margin: 40px 0 14px;
  }
  ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(230px, 1fr));
    gap: 28px 20px;
  }
  li {
    margin: 0;
  }
  a {
    display: block;
    color: var(--ink);
    text-decoration: none;
  }
  .frame {
    display: grid;
    place-items: center;
    padding: 14px;
    border: var(--edge);
    border-radius: 8px;
    background: var(--page);
    margin-bottom: 8px;
  }
  .frame :global(svg) {
    max-width: 100%;
  }
  a:hover .frame {
    border-color: var(--accent);
  }
  .t {
    font-weight: 600;
  }
  a:hover .t {
    color: var(--accent);
    text-decoration: underline;
  }
  p {
    margin: 2px 0 0;
    font-size: 0.88rem;
    color: var(--muted);
    line-height: 1.5;
  }
</style>
