---
// Dev-only previews of the three home layouts: /options/a, /options/b, /options/c.
// A build makes none of these pages. Delete this file once `home` in site.ts is settled.
import BaseLayout from '../../layouts/BaseLayout.astro';
import Home from '../../components/Home.astro';
import { name } from '../../data/site';

export function getStaticPaths() {
  return import.meta.env.DEV ? ['a', 'b', 'c'].map((v) => ({ params: { v } })) : [];
}
const v = Astro.params.v as 'a' | 'b' | 'c';
---

<BaseLayout title={`Option ${v.toUpperCase()} | ${name}`}>
  <Home variant={v} />
</BaseLayout>
