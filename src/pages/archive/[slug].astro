---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { name } from '../../data/site';

export async function getStaticPaths() {
  const posts = await getCollection('archive');
  return posts.map((post) => ({
    params: { slug: post.data.permalink },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await post.render();

const formattedDate = post.data.date.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<BaseLayout title={`${post.data.title} | ${name}`} description={post.data.description} window={`archive — ${post.data.date.getFullYear()}`} windowId="post">
  <p class="back"><a href="/archive">← archive</a></p>
  <article class="prose">
    <h1>{post.data.title}</h1>
    <p class="date"><time datetime={post.data.date.toISOString().slice(0, 10)}>{formattedDate}</time> <span>· archived essay</span></p>
    <Content />
  </article>
</BaseLayout>

<style>
  .date { font: 13px var(--mono); color: var(--muted); margin: -0.4em 0 1.6em; }
</style>
