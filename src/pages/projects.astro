---
import BaseLayout from '../layouts/BaseLayout.astro';
import { name, top8 } from '../data/site';

const rest = [...top8.filter((t) => t.featured), ...top8.filter((t) => !t.featured)];
---

<BaseLayout title={`Projects | ${name}`} description="Projects by Shingai Thornton.">
  <h1>Projects</h1>
  <ul class="grid">
    {rest.map((t) => (
      <li>
        <a href={t.href} class="shot"><img src={`/images/top8/${t.img}.jpg`} width="960" height="600" alt="" loading="lazy" /></a>
        <a class="t" href={t.href}>{t.title}</a>
        <span class="tag">{t.note}</span>
        {t.talk && <a class="talk" href={t.talk.href}>Talk: {t.talk.label}</a>}
      </li>
    ))}
  </ul>
</BaseLayout>

<style>
  h1 { font: 600 2.2rem/1.2 var(--serif); letter-spacing: -0.01em; margin: 0 0 32px; }
  .intro { color: var(--ink-2); margin-bottom: 32px; }
  .grid { display: grid; grid-template-columns: minmax(0, 1fr); gap: 32px 24px; list-style: none; margin: 0; padding: 0; }
  @media (min-width: 560px) { .grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 900px) { .grid { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 40px 28px; } }
  .grid li { display: flex; flex-wrap: wrap; align-items: baseline; gap: 2px 12px; margin: 0; }
  .shot { flex-basis: 100%; display: block; border: var(--edge); border-radius: 8px; overflow: hidden; margin-bottom: 10px; }
  .shot img { display: block; width: 100%; height: auto; aspect-ratio: 8 / 5; object-fit: cover; object-position: top; }
  .t { font-weight: 600; color: var(--ink); text-decoration: none; margin-right: auto; }
  .t:hover { color: var(--accent); text-decoration: underline; }
  .tag, .talk { font-size: 0.9rem; }
  .tag { color: var(--muted); }
</style>
