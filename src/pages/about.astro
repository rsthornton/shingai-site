---
import BaseLayout from '../layouts/BaseLayout.astro';
import { name, email, portrait, urls } from '../data/site';
---

<BaseLayout title={`About | ${name}`} doc>
  <div class="prose">
    <h1>About</h1>
    <img class="face" src={portrait.photo} width="512" height="512" alt={portrait.alt} />
    <!-- prettier-ignore -->
    <p class="lede">I'm studying <a href={urls.systemsScience}><mark>systems science</mark></a> at Binghamton University. I run <a href={urls.halcyonic}>Halcyonic Systems</a>, a small lab for <mark>formal systems research</mark>.</p>
    <p>
      <a href="/cv">CV</a>
    </p>

    <h2 id="contact">Contact</h2>
    <p>
      <a href={`mailto:${email}`}>{email}</a> · <a href={urls.call}>Book 20 minutes</a> · <a href={urls.x}>DM on X</a>
    </p>
  </div>
</BaseLayout>

<style>
  h2 {
    clear: both;
  }
  .lede {
    font-size: 1.15rem;
    line-height: 1.9;
  }
  .prose .face {
    display: block;
    width: 120px;
    height: 120px;
    border: 0;
    border-radius: 8px;
    margin: 0 0 20px;
  }
  @media (min-width: 640px) {
    .prose .face {
      float: right;
      width: 168px;
      height: 168px;
      margin: 6px 0 16px 32px;
    }
  }
</style>
