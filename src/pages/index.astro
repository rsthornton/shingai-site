---
import BaseLayout from '../layouts/BaseLayout.astro';
import { name, headline, thesis, now, links, email, callUrl, top8, talks, icons } from '../data/site';

const fmt = (d: string) =>
  new Date(d + 'T12:00:00').toLocaleDateString('en-US', { month: 'short', year: 'numeric' }).toLowerCase();
const reach = [
  { label: 'message', href: '#im', im: true },
  { label: 'book 20 min', href: callUrl },
  { label: 'x', href: links.find((l) => l.label === 'X')!.href },
  { label: 'github', href: links.find((l) => l.label === 'GitHub')!.href },
];
const imIcon = icons.kid;
---

<BaseLayout title={name} description={`${headline} ${thesis}`}>
  <main>
    <section class="hello">
      <img class="px" src={icons.headshot.pixel} width="56" height="56" alt="" />
      <h1>Hi, I'm Shingai.</h1>
      <!-- chip copy lives here, not in site.ts, while the design settles -->
      <p class="lede">
        I'm a PhD student in <span class="chip c1">systems science</span> at Binghamton.
        I run <span class="chip">Halcyonic Systems</span>, a small lab for <span class="nobr"><span class="chip c2">formal systems research</span>.</span>
      </p>
      <p class="thesis">{thesis}</p>
    </section>

    <hr class="rule" />

    <section class="now">
      {now.map((l, i) => <p><span class={i === 0 ? 'dot' : 'dot off'} aria-hidden="true"></span>{i === 0 ? 'currently' : 'also'}: {l.replace(/\.$/, '')}</p>)}
    </section>

    <section aria-labelledby="work-h">
      <div class="head"><h2 id="work-h" class="label">work</h2><span class="label" id="reel-count">1 / {top8.length}</span></div>
      <div class="reel box">
        <ol class="track" id="reel-track" tabindex="0" aria-roledescription="carousel" aria-label="Work">
          {top8.map((t, i) => (
            <li class="slide" aria-roledescription="slide" aria-label={`${i + 1} of ${top8.length}`}>
              <a href={t.href} tabindex="-1"><img src={`/images/top8/${t.img}.jpg`} width="480" height="300" alt="" loading={i < 2 ? 'eager' : 'lazy'} /></a>
              <div class="cap">
                <a class="t" href={t.href}>{t.title}</a>
                <span class="chip tag">{t.note}</span>
                {t.talk && <a class="chip talk" href={t.talk.href}>▶ {t.talk.label}</a>}
              </div>
            </li>
          ))}
        </ol>
        <div class="controls">
          <button type="button" class="chip" id="reel-prev" aria-label="Previous project">&lt; prev</button>
          <ol class="pips">
            {top8.map((t, i) => <li><button type="button" data-i={i} aria-label={t.title} aria-current={i === 0 ? 'true' : 'false'}></button></li>)}
          </ol>
          <button type="button" class="chip" id="reel-next" aria-label="Next project">next &gt;</button>
        </div>
      </div>
      <p class="spoken"><span class="label">spoken at:</span> {talks.map((t) => <a class="chip c2" href={t.href} title={t.title}>{t.short} · {fmt(t.date)}</a>)}</p>
    </section>

    <section>
      <h2 class="label">say hi</h2>
      <p class="reach">{reach.map((r) => <a class="chip" href={r.href} data-im={r.im ? '' : undefined}>{r.label} &gt;</a>)}</p>
    </section>
  </main>

  <div class="im" id="im" data-open="false">
    <button type="button" class="im-tab" id="im-tab">IM shingai ▴</button>
    <div class="im-win box" id="im-form">
      <div class="im-bar"><span>IM — shingai</span><button type="button" class="im-x" id="im-x" aria-label="Close">×</button></div>
      <div class="im-log"><img class="im-icon" src={imIcon.pixel} width="48" height="48" alt={imIcon.alt} /><p><span class="me">shingai:</span> hey, what are you working on?</p></div>
      <label class="sr" for="im-text">Message</label>
      <textarea id="im-text" rows="4" placeholder="type a message…"></textarea>
      <div class="im-send" role="group" aria-labelledby="im-via">
        <span id="im-via">send with</span>
        <button type="button" class="chip" data-via="gmail">Gmail</button>
        <button type="button" class="chip" data-via="outlook">Outlook</button>
        <button type="button" class="chip" data-via="app">Mail app</button>
        <button type="button" class="chip" data-via="copy">Copy</button>
      </div>
      <p class="im-note" id="im-note" aria-live="polite">goes to {email}</p>
    </div>
  </div>

  <script is:inline define:vars={{ email }}>
    (function () {
      var track = document.getElementById('reel-track'), count = document.getElementById('reel-count');
      var pips = document.querySelectorAll('.pips button'), slides = track.querySelectorAll('.slide'), n = slides.length, cur = 0;
      function go(i) { i = (i + n) % n; track.scrollTo({ left: slides[i].offsetLeft - slides[0].offsetLeft }); }
      function sync() {
        var x = track.scrollLeft + slides[0].offsetLeft, i = 0, best = Infinity;
        slides.forEach(function (s, j) { var d = Math.abs(s.offsetLeft - x); if (d < best) { best = d; i = j; } });
        if (track.scrollLeft + track.clientWidth >= track.scrollWidth - 2) i = n - 1;
        if (i === cur) return;
        cur = i;
        count.textContent = (i + 1) + ' / ' + n;
        pips.forEach(function (b, j) { b.setAttribute('aria-current', j === i ? 'true' : 'false'); });
      }
      var raf;
      track.addEventListener('scroll', function () { cancelAnimationFrame(raf); raf = requestAnimationFrame(sync); });
      document.getElementById('reel-prev').addEventListener('click', function () { go(cur - 1); });
      document.getElementById('reel-next').addEventListener('click', function () { go(cur + 1); });
      pips.forEach(function (b) { b.addEventListener('click', function () { go(+b.dataset.i); }); });
      track.addEventListener('keydown', function (e) {
        if (e.key === 'ArrowLeft') { e.preventDefault(); go(cur - 1); }
        if (e.key === 'ArrowRight') { e.preventDefault(); go(cur + 1); }
      });

      // IM: open by default on wide screens until the visitor closes it once
      var im = document.getElementById('im'), text = document.getElementById('im-text');
      function setOpen(open, focus) {
        im.dataset.open = open ? 'true' : 'false';
        if (open && focus) text.focus();
      }
      var closed = null; try { closed = localStorage.getItem('im:closed'); } catch (e) {}
      if (!closed && window.matchMedia('(min-width: 900px)').matches) setOpen(true, false);
      document.getElementById('im-tab').addEventListener('click', function () { setOpen(true, true); });
      document.getElementById('im-x').addEventListener('click', function () {
        setOpen(false); try { localStorage.setItem('im:closed', '1'); } catch (e) {}
      });
      document.querySelectorAll('[data-im]').forEach(function (a) {
        a.addEventListener('click', function (e) { e.preventDefault(); a.closest('details') && (a.closest('details').open = false); setOpen(true, true); });
      });
      if (location.hash === '#im') setOpen(true, true);

      var note = document.getElementById('im-note'), subject = 'IM from shingai.xyz';
      function remember(v) { try { localStorage.setItem('im:via', v); } catch (e) {} }
      function marked() {
        var last = null; try { last = localStorage.getItem('im:via'); } catch (e) {}
        document.querySelectorAll('[data-via]').forEach(function (b) { b.classList.toggle('c1', b.dataset.via === last); });
      }
      function copy(str, done) {
        if (navigator.clipboard) navigator.clipboard.writeText(str).then(done, function () { done(false); });
        else done(false);
      }
      var compose = {
        gmail: function (s, b) { return 'https://mail.google.com/mail/?view=cm&fs=1&to=' + encodeURIComponent(email) + '&su=' + encodeURIComponent(s) + '&body=' + encodeURIComponent(b); },
        outlook: function (s, b) { return 'https://outlook.live.com/mail/0/deeplink/compose?to=' + encodeURIComponent(email) + '&subject=' + encodeURIComponent(s) + '&body=' + encodeURIComponent(b); },
      };
      document.querySelectorAll('[data-via]').forEach(function (b) {
        b.addEventListener('click', function () {
          var via = b.dataset.via, body = text.value;
          remember(via); marked();
          if (compose[via]) window.open(compose[via](subject, body), '_blank', 'noopener');
          else if (via === 'app') window.location.href = 'mailto:' + email + '?subject=' + encodeURIComponent(subject) + '&body=' + encodeURIComponent(body);
          else copy(body ? body : email, function (ok) {
            note.textContent = ok === false ? 'copy failed: write to ' + email
              : body ? 'message copied: paste it into an email to ' + email : 'address copied: ' + email;
          });
        });
      });
      marked();
    })();
  </script>
</BaseLayout>

<style>
  main { display: grid; grid-template-columns: minmax(0, 1fr); gap: 48px; }

  .px { image-rendering: pixelated; border-radius: 8px; border: var(--edge); display: block; background: #fff; }
  .hello h1 { font: 700 3rem/1.1 var(--sans); color: var(--accent); letter-spacing: -0.03em; margin: 24px 0 20px; }
  .lede { font-size: 1.3rem; line-height: 1.9; margin-bottom: 16px; }
  .nobr { white-space: nowrap; }
  .thesis { color: var(--ink-2); font-size: 1.05rem; margin: 0; }

  .now p { font: 14px/1.6 var(--mono); color: var(--ink-2); margin: 0 0 6px; }
  .dot { display: inline-block; width: 8px; height: 8px; border-radius: 50%; background: #3fa66b; border: 1px solid var(--ink); margin-right: 10px; vertical-align: 0; }
  .dot.off { background: transparent; border-color: transparent; }

  .head { display: flex; justify-content: space-between; }

  .reel { overflow: hidden; background: var(--paper); }
  .track { display: flex; gap: 16px; overflow-x: auto; scroll-snap-type: x mandatory; scroll-padding: 0 16px; scrollbar-width: none; list-style: none; margin: 0; padding: 16px; }
  .track::-webkit-scrollbar { display: none; }
  .track:focus-visible { outline: 2px solid var(--accent); outline-offset: -4px; }
  @media (prefers-reduced-motion: no-preference) { .track { scroll-behavior: smooth; } }
  .slide { flex: 0 0 min(460px, 88%); scroll-snap-align: start; min-width: 0; }
  .slide:last-child { margin-right: 16px; }
  .slide > a { display: block; border: var(--edge); border-radius: 4px; overflow: hidden; }
  .slide img { display: block; width: 100%; height: auto; aspect-ratio: 8 / 5; object-fit: cover; object-position: top; transition: transform 200ms; }
  .slide > a:hover img { transform: scale(1.02); }
  .cap { display: flex; flex-wrap: wrap; align-items: center; gap: 6px 8px; padding: 12px 2px 0; }
  .cap .t { margin-right: auto; }
  .talk { font: 500 12px/1.6 var(--mono); background: var(--chip-1); text-decoration: none; margin: 0; }
  .talk:hover { text-decoration: underline; }
  .spoken { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; margin: 16px 0 0; }
  .spoken .label { margin: 0 4px 0 0; }
  .spoken .chip { font: 500 13px/1.6 var(--mono); text-decoration: none; margin: 0; }
  .spoken .chip:hover { text-decoration: underline; }
  .cap .t { font-weight: 600; font-size: 1.05rem; color: var(--ink); text-decoration: none; }
  .cap .t:hover { color: var(--accent); text-decoration: underline; }
  .tag { font: 12px/1.6 var(--mono); background: var(--chip-3); margin: 0; }

  .controls { display: flex; align-items: center; justify-content: space-between; gap: 10px; padding: 12px 16px; border-top: 1.5px dashed var(--line); background: var(--chip-3); }
  .controls .chip { font: 500 13px/1.6 var(--mono); cursor: pointer; margin: 0; }
  .controls .chip:hover { background: var(--chip-1); }
  .pips { display: flex; gap: 8px; list-style: none; margin: 0; padding: 0; }
  .pips button { display: block; width: 10px; height: 10px; padding: 0; border: var(--edge); border-radius: 0; background: #fff; cursor: pointer; }
  .pips button[aria-current='true'] { background: var(--accent); }

  .rows { list-style: none; margin: 0; padding: 0; }
  .rows li { display: flex; justify-content: space-between; align-items: baseline; gap: 16px; padding: 10px 0; border-bottom: 1.5px dashed var(--line); }
  .rows li:first-child { border-top: 1.5px dashed var(--line); }
  .rows a { color: var(--ink); text-decoration: none; font-weight: 500; }
  .rows a:hover { color: var(--accent); text-decoration: underline; }
  .rows .note { color: var(--muted); font-size: 0.9rem; text-align: right; flex-shrink: 0; max-width: 45%; }

  .reach { display: flex; flex-wrap: wrap; gap: 10px; margin: 0; }
  .reach .chip { font: 500 15px/1.7 var(--mono); text-decoration: none; padding: 2px 12px; }
  .reach .chip:hover { background: var(--chip-1); }

  .im { position: fixed; right: 16px; bottom: 0; z-index: 10; }
  .im-tab { font: 600 13px var(--mono); color: #fff; background: var(--accent); border: var(--edge); border-bottom: 0; border-radius: 8px 8px 0 0; padding: 7px 14px; cursor: pointer; }
  .im-win { display: none; width: min(320px, calc(100vw - 32px)); border-bottom: 0; border-radius: 8px 8px 0 0; overflow: hidden; }
  .im[data-open='true'] .im-tab { display: none; }
  .im[data-open='true'] .im-win { display: block; }
  .im-bar { display: flex; justify-content: space-between; align-items: center; padding: 6px 12px; background: var(--accent); color: #fff; font: 600 13px var(--mono); }
  .im-x { background: none; border: 0; color: #fff; font-size: 18px; line-height: 1; cursor: pointer; padding: 0 2px; }
  .im-log { display: flex; gap: 10px; align-items: flex-start; margin: 12px 12px 8px; font-size: 14px; }
  .im-log p { margin: 0; }
  .im-icon { flex: none; width: 48px; height: 48px; border: var(--edge); border-radius: 4px; image-rendering: pixelated; }
  .im-log .me { color: var(--accent); font-weight: 600; }
  .im-win textarea { display: block; box-sizing: border-box; width: calc(100% - 24px); margin: 0 12px; font: 14px var(--sans); border: 1px solid var(--line); border-radius: 4px; padding: 8px; resize: vertical; }
  .im-send { display: flex; flex-wrap: wrap; align-items: center; gap: 6px; padding: 10px 12px 4px; font: 12px var(--mono); color: var(--muted); }
  .im-send span { flex-basis: 100%; }
  .im-send .chip { font: 500 13px/1.6 var(--mono); cursor: pointer; margin: 0; }
  .im-send .chip:hover { background: var(--chip-1); }
  .im-note { margin: 0; padding: 4px 12px 12px; font: 12px var(--mono); color: var(--muted); overflow-wrap: anywhere; }

  @media (max-width: 520px) {
    .hello h1 { font-size: 2.4rem; }
    .lede { font-size: 1.15rem; }
    .rows li { flex-direction: column; gap: 0; }
    .rows .note { text-align: left; max-width: none; }
  }
</style>
