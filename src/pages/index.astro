---
// Home: the menu at the top, a drawing, the line, then the introduction.
// Which drawing and which intro come from `look` in src/data/site.ts. In dev mode every drawing and intro is
// rendered (hidden) so the toolbar can switch between them; production renders only the chosen ones.
import BaseLayout from '../layouts/BaseLayout.astro';
import Drawing from '../art/Drawing.astro';
import { drawings } from '../art/registry';
import { name, claim, who, theory, urls, look } from '../data/site';
import { projects } from '../data/projects';

const dev = import.meta.env.DEV;
const shown = dev ? drawings.map((d) => d.id) : [look.drawing];
const intros = ['who', 'working', 'work-first', 'line'] as const;
const hasIntro = (v: (typeof intros)[number]) => dev || look.intro === v;

const halcyonic = 'Halcyonic Systems';
const [before, after] = who.split(halcyonic);
const working = projects.slice(0, 3);
const dots = ['var(--frost-4)', 'var(--aurora-orange)', 'var(--aurora-purple)'];
---

<BaseLayout title={name}>
  <section class="home">
    <div class="art">
      {shown.map((id) => (
        <div data-art={id} hidden={id !== look.drawing}>
          <Drawing id={id} />
        </div>
      ))}
    </div>

    <h1>{claim}</h1>

    {hasIntro('who') && (
      <div data-intro="who" hidden={look.intro !== 'who'}>
        <!-- prettier-ignore -->
        <p class="who">{before}<a href={urls.halcyonic}>{halcyonic}</a>{after}</p>
      </div>
    )}

    {hasIntro('working') && (
      <div data-intro="working" hidden={look.intro !== 'working'}>
        <p class="label">Currently working on</p>
        <ul class="working">
          {working.map((p, i) => (
            <li>
              <span class="dot" style={`background:${dots[i]}`} />
              <a href={p.href}>{p.title}</a>
              <span class="blurb">{p.blurb}</span>
            </li>
          ))}
        </ul>
      </div>
    )}

    {hasIntro('work-first') && (
      <div data-intro="work-first" hidden={look.intro !== 'work-first'}>
        <!-- prettier-ignore -->
        <p class="who">Working on {working.map((p, i) => (<><a href={p.href}>{p.title}</a>{i === 0 ? ', ' : i === 1 ? ' and ' : '. '}</>))}PhD student in systems science at Binghamton; I run <a href={urls.halcyonic}>{halcyonic}</a>.</p>
      </div>
    )}

    {hasIntro('line') && <div data-intro="line" hidden={look.intro !== 'line'} />}

    {theory && <p class="theory">{theory}</p>}
  </section>
</BaseLayout>

<style>
  .home {
    display: grid;
    justify-items: center;
    text-align: center;
    padding: 2vh 0 12vh;
  }
  .art {
    width: min(400px, 86vw);
    margin-bottom: 36px;
  }
  h1 {
    font: 600 2.4rem/1.1 var(--serif);
    letter-spacing: -0.015em;
    margin: 0;
  }
  .who {
    max-width: 32em;
    margin: 16px 0 0;
    color: var(--ink-2);
    font-size: 1.08rem;
    line-height: 1.7;
  }
  .label {
    margin: 20px 0 8px;
    font: 500 12px var(--mono);
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .working {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 6px;
    text-align: left;
  }
  .working li {
    display: flex;
    align-items: baseline;
    gap: 10px;
    margin: 0;
  }
  .working .dot {
    flex: none;
    width: 9px;
    height: 9px;
    border-radius: 50%;
    transform: translateY(-1px);
  }
  .working a {
    font-weight: 600;
  }
  .blurb {
    color: var(--ink-2);
  }
  .theory {
    max-width: 34em;
    margin: 16px 0 0;
    font-size: 1.15rem;
  }
  @media (min-width: 900px) {
    h1 {
      font-size: 3.2rem;
    }
  }
</style>
