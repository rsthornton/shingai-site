---
// Home: the usual menu at the top, then one quiet drawing, the line and one sentence of who.
// Everything else is one click away in the menu.
import BaseLayout from '../layouts/BaseLayout.astro';
import HomeArt from '../components/HomeArt.astro';
import { name, claim, who, theory, urls } from '../data/site';

const variants = ['system', 'lattice', 'nested'] as const;
const chosen = 'system'; // the drawing shown; the others render hidden while Shingai chooses (?art=lattice)
const halcyonic = 'Halcyonic Systems';
const [before, after] = who.split(halcyonic);
---

<BaseLayout title={name}>
  <section class="home">
    <div class="art">
      {variants.map((v) => (
        <div data-art={v} hidden={v !== chosen}>
          <HomeArt variant={v} />
        </div>
      ))}
    </div>
    <h1>{claim}</h1>
    <!-- prettier-ignore -->
    <p class="who">{before}<a href={urls.halcyonic}>{halcyonic}</a>{after}</p>
    {theory && <p class="theory">{theory}</p>}
  </section>

  <!-- Temporary, while choosing a drawing: ?art=lattice or ?art=nested shows that one. Remove with the losers. -->
  <script is:inline>
    (function () {
      var want = new URLSearchParams(location.search).get('art');
      if (!want) return;
      document.querySelectorAll('[data-art]').forEach(function (el) {
        el.hidden = el.getAttribute('data-art') !== want;
      });
    })();
  </script>
</BaseLayout>

<style>
  .home {
    display: grid;
    justify-items: center;
    text-align: center;
    padding: 2vh 0 10vh;
  }
  .art {
    width: min(360px, 80vw);
    margin-bottom: 40px;
  }
  h1 {
    font: 600 2.4rem/1.1 var(--serif);
    letter-spacing: -0.015em;
    margin: 0;
  }
  .who {
    max-width: 32em;
    margin: 16px 0 0;
    color: var(--ink-2);
    font-size: 1.08rem;
    line-height: 1.7;
  }
  .theory {
    max-width: 34em;
    margin: 16px 0 0;
    font-size: 1.15rem;
  }
  @media (min-width: 900px) {
    h1 {
      font-size: 3.2rem;
    }
  }
</style>
