---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { name, headline, thesis, now, links, email, callUrl, top8, talks, icons } from '../data/site';

const essays = (await getCollection('archive')).length;
const fmt = (d: string) =>
  new Date(d + 'T12:00:00').toLocaleDateString('en-US', { month: 'short', year: 'numeric' }).toLowerCase();
const writing = [
  { title: 'ideas.halcyonic.systems', note: 'current writing, on substack', href: 'https://ideas.halcyonic.systems' },
  { title: 'archive', note: `${essays} essays, 2019–23`, href: '/archive' },
];
const reach = [
  { label: 'email', href: `mailto:${email}` },
  { label: 'book 20 min', href: callUrl },
  { label: 'x', href: links.find((l) => l.label === 'X')!.href },
  { label: 'github', href: links.find((l) => l.label === 'GitHub')!.href },
  { label: 'cv', href: '/cv' },
];
---

<BaseLayout title={name} description={`${headline} ${thesis}`}>
  <main>
    <section class="hello">
      <img class="px" src={icons.headshot.pixel} width="56" height="56" alt="" />
      <h1>Hi, I'm Shingai.</h1>
      <p class="lede">{headline} {thesis}</p>
      <p class="now"><span class="dot" aria-hidden="true"></span>currently: {now.map((l) => l.replace(/\.$/, '')).join(' · ')}</p>
    </section>

    <section>
      <h2>work</h2>
      <ul class="rows">
        {top8.map((t) => (
          <li><a href={t.href}>{t.title}</a><span class="note">{t.note}</span></li>
        ))}
      </ul>
    </section>

    <section>
      <h2>talks</h2>
      <ul class="rows">
        {talks.map((t) => (
          <li><a href={t.href}>{t.title}</a><span class="note">{t.venue.split(',')[0].replace(/ \(.*\)/, '')} · {fmt(t.date)}</span></li>
        ))}
      </ul>
    </section>

    <section>
      <h2>writing</h2>
      <ul class="rows">
        {writing.map((w) => (
          <li><a href={w.href}>{w.title}</a><span class="note">{w.note}</span></li>
        ))}
      </ul>
    </section>

    <section>
      <h2>say hi</h2>
      <p class="reach">{reach.map((r) => <a href={r.href}>{r.label}&gt;</a>)}</p>
    </section>
  </main>
</BaseLayout>

<style>
  main { display: grid; gap: 56px; }

  .hello h1 { font-size: 2rem; line-height: 1.2; font-weight: 600; letter-spacing: -0.015em; margin: 20px 0 12px; }
  .px { image-rendering: pixelated; border-radius: 8px; display: block; }
  .lede { font-size: 1.1rem; color: var(--ink-2); max-width: 34em; }
  .now { font: 14px/1.6 var(--mono); color: var(--muted); margin-top: 20px; }
  .dot { display: inline-block; width: 7px; height: 7px; border-radius: 50%; background: #3fa66b; margin-right: 8px; vertical-align: 1px; }

  h2 { font: 500 13px var(--mono); color: var(--muted); text-transform: lowercase; letter-spacing: 0.04em; margin: 0 0 12px; }

  .rows { list-style: none; margin: 0; padding: 0; }
  .rows li { display: flex; justify-content: space-between; align-items: baseline; gap: 16px; padding: 9px 0; border-bottom: 1px solid var(--line); }
  .rows li:first-child { border-top: 1px solid var(--line); }
  .rows a { color: var(--ink); text-decoration: none; }
  .rows a:hover { color: var(--link); }
  .note { color: var(--muted); font-size: 0.9rem; text-align: right; flex-shrink: 0; max-width: 45%; }

  .reach { display: flex; flex-wrap: wrap; gap: 8px 20px; font: 15px var(--mono); }
  .reach a { text-decoration: none; }
  .reach a:hover { text-decoration: underline; }

  @media (max-width: 520px) {
    .rows li { flex-direction: column; gap: 0; }
    .note { text-align: left; max-width: none; }
  }
</style>
