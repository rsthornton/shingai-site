---
// Home: one big claim (and the theory of change once there is one), then the featured projects.
import BaseLayout from '../layouts/BaseLayout.astro';
import Im from '../components/Im.astro';
import { name, headline, claim, theory, top8 } from '../data/site';

// "[word]" marks a highlight; split into text and highlighted parts
const parts = theory.split(/\[([^\]]+)\]/).map((t, i) => ({ t, chip: i % 2 === 1 }));
const featured = top8.filter((t) => t.featured);
---

<BaseLayout title={name} description={headline}>
  <main>
    <section class="hello">
      <h1>{claim}</h1>
      {theory && <p class="lede">{parts.map((p) => (p.chip ? <mark>{p.t}</mark> : p.t))}</p>}
    </section>

    <section aria-labelledby="work-h">
      <h2 id="work-h">Working on</h2>
      <ul class="cards">
        {featured.map((t) => (
          <li>
            <a href={t.href} class="shot"><img src={`/images/top8/${t.img}.jpg`} width="960" height="600" alt="" /></a>
            <span class="kind">{t.kind}</span>
            <a class="t" href={t.href}>{t.title}</a>
            <p>{t.blurb}</p>
            {t.talk && <a class="talk" href={t.talk.href}>Talk: {t.talk.label}</a>}
          </li>
        ))}
      </ul>
      <p class="more"><a href="/projects">All projects</a> · <a href="/about#talks">Talks</a> · <a href="/cv">CV</a></p>
    </section>
  </main>
  <Im />
</BaseLayout>

<style>
  main { display: grid; grid-template-columns: minmax(0, 1fr); gap: 64px; }
  h1 { font: 600 2.4rem/1.1 var(--serif); letter-spacing: -0.015em; margin: 0; }
  .lede { font-size: 1.15rem; line-height: 1.75; color: var(--ink-2); margin: 24px 0 0; max-width: 34em; }
  h2 { font: 600 1.6rem/1.2 var(--serif); margin: 0 0 20px; }
  .cards { display: grid; grid-template-columns: minmax(0, 1fr); gap: 40px; list-style: none; margin: 0; padding: 0; }
  .cards li { margin: 0; }
  .cards p { margin: 4px 0 6px; color: var(--ink-2); }
  .shot { display: block; border: var(--edge); border-radius: 8px; overflow: hidden; margin-bottom: 14px; }
  .shot img { display: block; width: 100%; height: auto; aspect-ratio: 8 / 5; object-fit: cover; object-position: top; transition: transform 200ms; }
  .shot:hover img { transform: scale(1.02); }
  .kind { display: block; font: 500 12px var(--mono); color: var(--muted); letter-spacing: 0.04em; text-transform: uppercase; margin-bottom: 2px; }
  .t { font: 600 1.25rem var(--serif); color: var(--ink); text-decoration: none; }
  .t:hover { color: var(--accent); text-decoration: underline; }
  .talk { font-size: 0.9rem; }
  .more { color: var(--muted); font-size: 0.95rem; margin: 36px 0 0; }
  @media (min-width: 700px) { .cards { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 28px; } }
  @media (min-width: 900px) {
    h1 { font-size: 3.75rem; }
    .lede { font-size: 1.35rem; }
  }
</style>
