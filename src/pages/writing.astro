---
// Writing: one vertical list, tabs to switch views (radio buttons and CSS, no script).
// Field notes come from the blyg's feed; essays are kept here. Talks live on /projects.
import BaseLayout from '../layouts/BaseLayout.astro';
import { name, urls } from '../data/site';
import { writing } from '../data/writing';

const items = await writing();
const n = (k: string) => items.filter((i) => i.kind === k).length;
const tabs = [
  { id: 'all', label: 'All', count: items.length },
  { id: 'note', label: 'Field notes', count: n('note') },
  { id: 'essay', label: 'Essays', count: n('essay') },
];
const date = (d: Date) => d.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
---

<BaseLayout title={`Writing | ${name}`} description="Essays and field notes by Shingai Thornton." doc>
  <h1>Writing</h1>
  <p class="intro">
    Field notes from my <a href={urls.blyg}>blyg</a> and essays from 2019 on, in one <a href="/rss.xml">RSS feed</a>.
    Also: <a href={urls.newsletter}>Ideas</a>, the newsletter (<a href={urls.newsletterArchive}>older issues</a>), and
    the <a href={urls.thesis}>MS thesis</a>.
  </p>

  <div class="tabs" role="group" aria-label="Show">
    {tabs.map((t, i) => (
      <>
        <input type="radio" name="kind" id={`w-${t.id}`} checked={i === 0} aria-controls="writing-list" />
        <label for={`w-${t.id}`}>
          {t.label} <span>{t.count}</span>
        </label>
      </>
    ))}
    <ul class="list" id="writing-list">
      {items.map((i) => (
        <li data-kind={i.kind}>
          <span class="t">
            <a href={i.href}>{i.title}</a>
            {i.external && <span class="out"> ↗</span>}
          </span>
          <span class="meta">
            {i.kind === 'note' ? 'note' : 'essay'} · {date(i.date)}
          </span>
        </li>
      ))}
    </ul>
  </div>
</BaseLayout>

<style>
  h1 {
    font: 600 2.4rem/1.15 var(--serif);
    letter-spacing: -0.01em;
    margin: 0 0 12px;
  }
  .intro {
    color: var(--ink-2);
    margin-bottom: 28px;
  }

  .tabs > input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }
  .tabs > label {
    display: inline-block;
    margin: 0 20px 8px 0;
    padding: 6px 0;
    color: var(--muted);
    cursor: pointer;
    border-bottom: 2px solid transparent;
  }
  .tabs > label span {
    font: 12px var(--mono);
  }
  .tabs > label:hover {
    color: var(--ink);
  }
  .tabs > input:checked + label {
    color: var(--ink);
    border-bottom-color: var(--accent);
  }
  .tabs > input:focus-visible + label {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  .list {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: var(--edge);
  }
  .list li {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: 2px 16px;
    padding: 10px 0;
    border-bottom: var(--edge);
    margin: 0;
  }
  .t {
    margin-right: auto;
  }
  .list a {
    color: var(--ink);
    text-decoration: none;
    font-weight: 500;
  }
  .list a:hover {
    color: var(--accent);
    text-decoration: underline;
  }
  .out {
    color: var(--muted);
    font-size: 0.85em;
  }
  .meta {
    flex: none;
    font: 13px var(--mono);
    color: var(--muted);
  }

  #w-note:checked ~ .list li:not([data-kind='note']),
  #w-essay:checked ~ .list li:not([data-kind='essay']) {
    display: none;
  }
</style>
