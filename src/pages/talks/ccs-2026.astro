---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { name, talks } from '../../data/site';
import abstract from '../../data/ccs-2026-abstract.json';

const talk = talks.find((t) => t.href === '/talks/ccs-2026')!;
const facts = [
  ['date', 'Friday, October 16, 2026'],
  ['venue', `${talk.venue}, ${talk.place}`],
  ['session', 'Parallel 07, Track 1: Connectivity, Influence, and Spreading Across Complex Networks'],
  ['format', '12-minute oral'],
];
const materials = [
  { label: 'Slides', href: '/talks/ccs-2026-slides.pdf', note: 'PDF, 12 slides, as presented' },
  { label: 'Interactive map and data', href: 'https://ustradeflow.systems', note: 'ustradeflow.systems' },
  { label: 'Pre-registered test', href: 'https://www.researchhub.com/proposal/32374/', note: 'ResearchHub, registered June 2026' },
  { label: 'Code and thesis', href: 'https://github.com/rsthornton/us-trade-centrality', note: 'GitHub' },
];
---

<BaseLayout title={`CCS 2026 talk | ${name}`} description={`${talk.title}. ${name} at CCS 2026.`} window="talk — CCS 2026" windowId="talk">
  <p class="back"><a href="/about#talks">← talks</a></p>

  <h1>{talk.title}</h1>
  <p class="by">{name}, Systems Science, Binghamton University</p>

  <table class="facts">
    <tbody>
      {facts.map(([k, v]) => (
        <tr><th scope="row">{k}</th><td>{v}</td></tr>
      ))}
    </tbody>
  </table>

  <h2>materials</h2>
  <ul class="materials">
    {materials.map((m) => (
      <li><a href={m.href}>{m.label}</a> <span class="muted">· {m.note}</span></li>
    ))}
  </ul>

  <h2>abstract, as submitted (April 2026)</h2>
  <div class="prose">
    {abstract.map((p: string) => <p>{p}</p>)}
  </div>
</BaseLayout>

<style>
  h1 { font-size: 24px; line-height: 1.3; margin: 0 0 6px; }
  .by { color: var(--ink-2); margin: 0 0 20px; }
  h2 { font: 600 13px var(--mono); color: var(--ink-2); margin: 28px 0 10px; padding-bottom: 6px; border-bottom: 1px solid var(--line); }
  .facts { width: 100%; border-collapse: collapse; font-size: 15px; }
  .facts th { text-align: left; font: 13px var(--mono); color: var(--muted); padding: 7px 16px 7px 0; vertical-align: top; width: 8ch; }
  .facts td { padding: 7px 0; }
  .facts tr { border-bottom: 1px solid var(--line); }
  .materials { list-style: none; padding: 0; margin: 0; }
  .materials li { padding: 5px 0; }
  .materials li::before { content: '> '; color: var(--muted); font-family: var(--mono); }
  .materials .muted { font-size: 14px; }
</style>
