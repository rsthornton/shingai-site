---
import { name, updated } from '../data/site';
import Icons from '../components/Icons.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  window?: string; // subpages still pass this; it now just means "a document page"
  windowId?: string;
  bare?: boolean; // home: no header or footer, the page is the navigation
}

const {
  title,
  description = 'Shingai Thornton: PhD student in Systems Science at Binghamton University; runs Halcyonic Systems.',
  window: isDoc,
  bare = false,
} = Astro.props;

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const ogImage = new URL('/images/icon/headshot.jpg', Astro.site).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="view-transition" content="same-origin" />
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={new URL(Astro.url.pathname, Astro.site).href} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="application/rss+xml" title={`${name}: writing`} href="/rss.xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=IBM+Plex+Sans:ital,wght@0,400;0,500;0,600;1,400&family=Source+Serif+4:opsz,wght@8..60,400;8..60,600;8..60,700&display=swap" rel="stylesheet" />
    <title>{title}</title>
  </head>
  <body>
    <div class="column">
      {!bare && <header class="top">
        <a class="logo" href="/">Shingai Thornton</a>
        <nav aria-label="Site">
          <a href="/projects" aria-current={path.startsWith('/projects') ? 'page' : undefined}>Projects</a>
          <a href="/writing" aria-current={path.startsWith('/writing') || path.startsWith('/archive') ? 'page' : undefined}>Writing</a>
          <a href="/about" aria-current={path.startsWith('/about') || path.startsWith('/cv') ? 'page' : undefined}>About</a>
          <span class="social"><Icons only={['x', 'github', 'rss']} /></span>

        </nav>
      </header>}

      {isDoc ? <article class="doc"><slot /></article> : <slot />}
    </div>

    {!bare && <footer class="foot">
      <div class="column">
        <span>&copy; {updated.slice(0, 4)} {name}</span>
        <span>updated {updated}</span>
      </div>
    </footer>}

    <script is:inline>
      document.addEventListener('click', function (e) {
        document.querySelectorAll('details.menu[open]').forEach(function (d) { if (!d.contains(e.target)) d.open = false; });
      });
    </script>
  </body>
</html>
