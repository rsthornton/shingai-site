---
import Win from '../components/Win.astro';
import { name, updated, top8 } from '../data/site';
import { getCollection } from 'astro:content';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  window?: string;
  windowId?: string;
}

const {
  title,
  description = 'Shingai Thornton: PhD student in Systems Science at Binghamton University; runs Halcyonic Systems.',
  window: winTitle,
  windowId = 'page',
} = Astro.props;

const essays = (await getCollection('archive')).length;
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const nav = [
  { label: 'home', href: '/' },
  { label: 'archive', href: '/archive' },
  { label: 'cv', href: '/cv' },
];
const current = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
const ogImage = new URL('/images/icon/headshot.jpg', Astro.site).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="view-transition" content="same-origin" />
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={new URL(Astro.url.pathname, Astro.site).href} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;600&family=IBM+Plex+Sans:ital,wght@0,400;0,600;1,400&display=swap" rel="stylesheet" />
    <title>{title}</title>
  </head>
  <body>
    <div class="strip">
      <span><span class="led" aria-hidden="true"></span>connected<span class="hide-sm"> · sharing {top8.length} projects · {essays} essays</span></span>
      <nav aria-label="Site">
        {nav.map((n) => <a href={n.href} aria-current={current(n.href) ? 'page' : undefined}>{n.label}</a>)}
      </nav>
      <span class="hide-sm">last online {updated}</span>
    </div>

    {winTitle ? (
      <div class="column">
        <Win id={windowId} title={winTitle}>
          <div class="doc"><slot /></div>
        </Win>
        <footer class="page-foot">
          <span>&copy; {updated.slice(0, 4)} {name}</span>
          <span>end of file.</span>
        </footer>
      </div>
    ) : (
      <slot />
    )}
  </body>
</html>
