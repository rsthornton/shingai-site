---
// Every page: head and social tags, the header with the site menu, a main region and the footer.
import { name, who, updated, portrait, urls } from '../data/site';
import Icons from '../components/Icons.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  /** Wrap the page in the narrow reading column (CV, essays, talk pages). */
  doc?: boolean;
}

const { title, description = `${name}: ${who}`, doc = false } = Astro.props;

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const menu = [
  { href: '/projects', label: 'Projects', current: path.startsWith('/projects') || path.startsWith('/talks') },
  { href: '/writing', label: 'Writing', current: path.startsWith('/writing') || path.startsWith('/archive') },
  { href: '/about', label: 'About', current: path.startsWith('/about') || path.startsWith('/cv') },
];
const ogImage = new URL(portrait.photo, Astro.site).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="view-transition" content="same-origin" />
    <meta name="description" content={description} />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site).href} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={new URL(Astro.url.pathname, Astro.site).href} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="application/rss+xml" title={`${name}: writing`} href="/rss.xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=IBM+Plex+Sans:ital,wght@0,400;0,500;0,600;1,400&family=Source+Serif+4:opsz,wght@8..60,400;8..60,600;8..60,700&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
    <!-- LAB (temporary): apply the palette chosen on home before first paint. -->
    <script is:inline>
      (function (r, s) {
        ['palette', 'ink', 'heading'].forEach(function (k) {
          var v = s.getItem('lab-' + k);
          if (v) r.dataset[k] = v;
        });
      })(document.documentElement, localStorage);
    </script>
  </head>
  <body>
    <a class="skip" href="#main">
      Skip to content
    </a>
    <div class="column">
      <header class="top">
        <a class="logo" href="/" aria-current={path === '/' ? 'page' : undefined}>
          {name}
        </a>
        <nav aria-label="Site">
          {menu.map((m) => (
            <a href={m.href} aria-current={m.current ? 'page' : undefined}>
              {m.label}
            </a>
          ))}
          <span class="social">
            <Icons only={['x', 'github', 'rss']} />
          </span>
        </nav>
      </header>

      <main id="main" class:list={{ doc }}>
        <slot />
      </main>
    </div>

    <footer class="foot">
      <div class="column">
        <span>
          &copy; {updated.slice(0, 4)} {name}
        </span>
        <span>
          <a href={urls.source}>source</a> · updated {updated}
        </span>
      </div>
    </footer>
  </body>
</html>
