---
import { name, updated } from '../data/site';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  window?: string; // subpages still pass this; it now just means "a document page"
  windowId?: string;
}

const {
  title,
  description = 'Shingai Thornton: PhD student in Systems Science at Binghamton University; runs Halcyonic Systems.',
  window: isDoc,
} = Astro.props;

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const nav = [
  { label: 'archive', href: '/archive' },
  { label: 'cv', href: '/cv' },
];
const current = (href: string) => path.startsWith(href);
const ogImage = new URL('/images/icon/headshot.jpg', Astro.site).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="view-transition" content="same-origin" />
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={new URL(Astro.url.pathname, Astro.site).href} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=IBM+Plex+Sans:ital,wght@0,400;0,500;0,600;1,400&display=swap" rel="stylesheet" />
    <title>{title}</title>
  </head>
  <body>
    <div class="column">
      <header class="top">
        <a class="home" href="/">{path === '/' ? 'shingai.xyz' : '← shingai.xyz'}</a>
        <nav aria-label="Site">
          {nav.map((n) => <a href={n.href} aria-current={current(n.href) ? 'page' : undefined}>{n.label}&gt;</a>)}
        </nav>
      </header>

      {isDoc ? <article class="doc"><slot /></article> : <slot />}

      <footer class="foot">
        <span>&copy; {updated.slice(0, 4)} {name}</span>
        <span>updated {updated}</span>
      </footer>
    </div>
  </body>
</html>
