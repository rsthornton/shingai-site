---
import { getCollection } from 'astro:content';
import { name, updated } from '../data/site';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  window?: string; // subpages still pass this; it now just means "a document page"
  windowId?: string;
}

const {
  title,
  description = 'Shingai Thornton: PhD student in Systems Science at Binghamton University; runs Halcyonic Systems.',
  window: isDoc,
} = Astro.props;

const essays = (await getCollection('archive')).length;
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const writing = [
  { label: 'ideas', note: 'substack, now', href: 'https://ideas.halcyonic.systems' },
  { label: 'archive', note: `${essays} essays, 2019–23`, href: '/archive' },
];
const ogImage = new URL('/images/icon/headshot.jpg', Astro.site).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="view-transition" content="same-origin" />
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={new URL(Astro.url.pathname, Astro.site).href} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600&family=IBM+Plex+Sans:ital,wght@0,400;0,500;0,600;0,700;1,400&display=swap" rel="stylesheet" />
    <!-- ?lift in the URL turns on Chai-style hard offset shadows, for comparing -->
    <script is:inline>if (/[?&]lift\b/.test(location.search)) document.documentElement.dataset.lift = '';</script>
    <title>{title}</title>
  </head>
  <body>
    <div class="column">
      <header class="bar top">
        <a class="logo" href="/">shingai.</a>
        <nav aria-label="Site">
          <details class="menu">
            <summary aria-current={path.startsWith('/archive') ? 'page' : undefined}>writing&gt;</summary>
            <ul class="box">
              {writing.map((w) => <li><a href={w.href}><span>{w.label}</span><span class="note">{w.note}</span></a></li>)}
            </ul>
          </details>
          <a href="/cv" aria-current={path.startsWith('/cv') ? 'page' : undefined}>cv&gt;</a>
          <a href="/#im" data-im>im&gt;</a>
        </nav>
      </header>

      {isDoc ? <article class="doc box"><slot /></article> : <slot />}
    </div>

    <footer class="foot">
      <div class="column">
        <span>&copy; {updated.slice(0, 4)} {name}</span>
        <span>updated {updated}</span>
      </div>
    </footer>

    <script is:inline>
      document.addEventListener('click', function (e) {
        document.querySelectorAll('details.menu[open]').forEach(function (d) { if (!d.contains(e.target)) d.open = false; });
      });
    </script>
  </body>
</html>
