---
// Drawings after George Mobus (and Odum, whose energy language he builds on).
import Arrow from './Arrow.astro';
import { ground, head, ngon } from './geom';

interface Props {
  id: string;
}
const { id } = Astro.props;
---

{id === 'mobus-system' && (
  <g>
    <circle cx="160" cy="120" r="80" class="k fw" />
    <circle cx="26" cy="86" r="12" class="o fo" />
    <rect x="14" y="140" width="24" height="24" rx="3" class="b fb" />
    <rect x="282" y="94" width="24" height="24" rx="3" class="b fb" />
    <g class="o fl">
      <path d="M38 86 L80 98" />
    </g>
    <g class="b fl">
      <path d="M38 152 L82 146" />
      <path d="M240 108 L282 106" />
    </g>
    <g class="o">
      <path d="M110 100 L180 118" class="fl" />
    </g>
    <g class="b">
      <path d="M84 146 L124 150 L180 124" class="fl" />
      <path d="M196 118 L240 108" class="fl" />
    </g>
    <Arrow a={[188, 106]} b={[118, 92]} bend={18} class="g d" gapA={8} gapB={10} />
    <g class="o d">
      <path d="M188 128 L172 198" />
    </g>
    <path d={ground(172, 200)} class="k" />
    <rect x="77" y="95" width="7" height="7" class="k fw" />
    <rect x="80" y="143" width="7" height="7" class="k fw" />
    <rect x="237" y="104" width="7" height="7" class="k fw" />
    <rect x="168" y="196" width="7" height="7" class="k fw" />
    <circle cx="110" cy="100" r="9" class="n" />
    <circle cx="124" cy="150" r="9" class="n" />
    <circle cx="188" cy="118" r="12" class="n" />
  </g>
)}

{id === 'mobus-zoom' && (
  <g>
    <circle cx="64" cy="120" r="48" class="k fw" />
    <circle cx="48" cy="102" r="12" class="k" />
    <circle cx="66" cy="146" r="11" class="k" />
    <circle cx="84" cy="106" r="11" class="a ft" />
    <g class="m thin d">
      <path d="M84 95 L175 80" />
      <path d="M84 117 L175 160" />
    </g>
    <circle cx="175" cy="120" r="40" class="b fw" />
    <g class="b thin">
      <path d="M160 104 L194 108 L176 140 Z" />
    </g>
    <circle cx="160" cy="104" r="6" class="n" />
    <circle cx="176" cy="140" r="6" class="n" />
    <circle cx="194" cy="108" r="7" class="p fp" />
    <g class="m thin d">
      <path d="M194 101 L268 96" />
      <path d="M194 115 L268 144" />
    </g>
    <circle cx="268" cy="120" r="24" class="p fw" />
    {[
      [258, 112],
      [272, 108],
      [280, 122],
      [266, 130],
      [256, 124],
    ].map(([x, y]) => (
      <circle cx={x} cy={y} r="2.6" class="p dot" />
    ))}
  </g>
)}

{id === 'mobus-nested' && (
  <g>
    <circle cx="160" cy="120" r="102" class="k fw" />
    <circle cx="116" cy="96" r="38" class="b fb" />
    <circle cx="206" cy="98" r="32" class="g fg" />
    <circle cx="160" cy="172" r="30" class="p fp" />
    {[
      [102, 86, 'b'],
      [130, 104, 'b'],
      [112, 116, 'b'],
      [198, 92, 'g'],
      [216, 108, 'g'],
      [150, 168, 'p'],
      [172, 178, 'p'],
    ].map(([x, y, c]) => (
      <circle cx={x} cy={y} r="5" class={`${c} fw`} />
    ))}
    <Arrow a={[152, 100]} b={[176, 100]} class="o fl" size={5} />
    <Arrow a={[136, 128]} b={[148, 146]} class="b fl" size={5} />
    <Arrow a={[188, 126]} b={[176, 146]} class="g fl" size={5} />
  </g>
)}

{id === 'mobus-governance' && (
  <g>
    <rect x="24" y="24" width="272" height="196" rx="8" class="k" />
    <rect x="122" y="40" width="76" height="30" rx="4" class="p fp" />
    <rect x="48" y="98" width="224" height="22" rx="4" class="g fg" />
    {[60, 140, 220].map((x) => (
      <rect x={x} y="160" width="40" height="34" rx="4" class="b fb" />
    ))}
    <g class="b fl">
      <path d="M8 177 L60 177" />
      <path d="M100 177 L140 177" />
      <path d="M180 177 L220 177" />
      <path d="M260 177 L312 177" />
    </g>
    {[80, 160, 240].map((x) => (
      <g class="g d">
        <path d={`M${x} 120 V160`} />
      </g>
    ))}
    <g class="p d">
      <path d="M160 70 V98" />
    </g>
    <Arrow a={[198, 52]} b={[310, 30]} class="p d" bend={-10} />
    <Arrow a={[310, 70]} b={[198, 62]} class="p d" bend={-10} />
  </g>
)}

{id === 'mobus-agent' && (
  <g>
    <rect x="96" y="60" width="128" height="96" rx="8" class="k fw" />
    <path d="M104 108 L118 98 L118 118 Z" class="t ft" />
    <ellipse cx="150" cy="92" rx="22" ry="14" class="p fp" />
    <polygon points={ngon(176, 124, 11, 4, 0)} class="a fw" />
    <rect x="200" y="100" width="16" height="16" rx="2" class="o fo" />
    <Arrow a={[118, 106]} b={[150, 92]} gapB={22} class="k thin" size={5} />
    <Arrow a={[160, 105]} b={[176, 124]} gapB={11} class="k thin" size={5} />
    <Arrow a={[187, 122]} b={[208, 108]} gapB={8} class="k thin" size={5} />
    <path d="M216 108 C300 108 312 206 160 212 C8 218 20 108 98 108" class="t fl" />
    <path d={head(103, 108, 0)} class="t h" />
    <path d={head(276, 143, 1.33)} class="t h" />
    {[
      [60, 200],
      [270, 206],
      [150, 228],
    ].map(([x, y]) => (
      <circle cx={x} cy={y} r="3" class="m dot" />
    ))}
  </g>
)}

{id === 'mobus-odum' && (
  <g>
    <circle cx="34" cy="120" r="16" class="o fo" />
    <path d="M82 100 H112 A20 20 0 0 1 112 140 H82 Z" class="g fg" />
    <path d="M160 96 V134 Q160 148 176 148 Q192 148 192 134 V96" class="b fb" />
    <polygon points={ngon(254, 120, 22, 6, 0)} class="p fp" />
    <Arrow a={[50, 120]} b={[82, 120]} class="o" />
    <Arrow a={[132, 120]} b={[160, 120]} class="g" />
    <Arrow a={[192, 120]} b={[232, 120]} class="b" />
    <g class="o d thin">
      <path d="M100 140 V172" />
      <path d="M176 148 V172" />
      <path d="M254 142 V172" />
    </g>
    <path d={ground(100, 172)} class="k" />
    <path d={ground(176, 172)} class="k" />
    <path d={ground(254, 172)} class="k" />
    <path d="M254 98 V70 H104 V100" class="p d" />
    <path d="M104 100 L100 92 L108 92 Z" class="p h" />
  </g>
)}

{id === 'mobus-economy' && (
  <g>
    <circle cx="36" cy="44" r="12" class="o fy" />
    {[0, 45, 90, 135, 180, 225, 270, 315].map((a) => {
      const r = (a * Math.PI) / 180;
      return (
        <path
          d={`M${36 + 17 * Math.cos(r)} ${44 + 17 * Math.sin(r)} L${36 + 23 * Math.cos(r)} ${44 + 23 * Math.sin(r)}`}
          class="o thin"
        />
      );
    })}
    <path d="M14 140 V168 Q14 178 28 178 Q42 178 42 168 V140" class="b fb" />
    {[
      [70, 'b'],
      [138, 'g'],
      [206, 'p'],
    ].map(([x, c]) => (
      <rect x={x} y="124" width="44" height="34" rx="4" class={`${c} f${c === 'b' ? 'b' : c === 'g' ? 'g' : 'p'}`} />
    ))}
    <Arrow a={[42, 150]} b={[70, 141]} class="b fl" />
    <Arrow a={[114, 141]} b={[138, 141]} class="b fl" />
    <Arrow a={[182, 141]} b={[206, 141]} class="b fl" />
    <Arrow a={[250, 141]} b={[286, 170]} class="b fl" />
    <path d={ground(292, 176)} class="k" />
    <Arrow a={[48, 54]} b={[160, 124]} bend={-30} class="o d" />
    <Arrow a={[236, 172]} b={[84, 172]} class="p d" size={5} />
    <Arrow a={[290, 168]} b={[160, 124]} bend={70} class="g d" />
    <g class="m thin d">
      <path d="M92 124 V96 H228 V124" />
      <path d="M160 96 V124" />
    </g>
  </g>
)}

{id === 'mobus-stock' && (
  <g>
    <path
      d="M22 118 q-10 -14 6 -18 q6 -12 20 -4 q14 -4 14 10 q12 6 2 16 q-4 12 -18 6 q-14 8 -20 -2 q-14 0 -4 -8 Z"
      class="m fw"
    />
    <path
      d="M258 118 q-10 -14 6 -18 q6 -12 20 -4 q14 -4 14 10 q12 6 2 16 q-4 12 -18 6 q-14 8 -20 -2 q-14 0 -4 -8 Z"
      class="m fw"
    />
    <g class="b">
      <path d="M64 113 H120 M64 123 H120" />
      <path d="M200 113 H256 M200 123 H256" />
    </g>
    <path d="M84 104 L100 132 L100 104 L84 132 Z" class="b fb" />
    <path d="M220 104 L236 132 L236 104 L220 132 Z" class="b fb" />
    <rect x="120" y="86" width="80" height="64" rx="4" class="k fw" />
    <rect x="121" y="114" width="78" height="35" class="b fb" style="stroke:none" />
    <Arrow a={[160, 86]} b={[92, 100]} bend={-34} class="r thin" size={5} />
    <Arrow a={[180, 150]} b={[228, 136]} bend={-24} class="r thin d" size={5} />
  </g>
)}
