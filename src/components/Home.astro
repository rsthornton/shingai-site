---
// The home page in three layouts. `home` in site.ts picks the one that ships.
//   a: statement. One big claim (and the theory of change once there is one), three projects with screenshots.
//   b: index. Text only: the paragraph, then every project and talk as rows.
//   c: profile. Who on the left, the work stacked large on the right.
import Im from './Im.astro';
import { claim, theory, lede, bio, top8, talks, callUrl, email, icons } from '../data/site';

interface Props { variant: 'a' | 'b' | 'c' }
const { variant } = Astro.props;

// "[word]" marks a highlight; split into text and highlighted parts
const split = (s: string) => s.split(/\[([^\]]+)\]/).map((t, i) => ({ t, chip: i % 2 === 1 }));
const parts = split(lede);
const featured = top8.filter((t) => t.featured);
const ordered = [...featured, ...top8.filter((t) => !t.featured)];
const fmt = (d: string) => new Date(d + 'T12:00:00').toLocaleDateString('en-US', { month: 'short', year: 'numeric' });
---

{variant === 'a' && (
  <main class="a">
    <section class="hello">
      <h1>{claim}</h1>
      {theory && <p class="lede">{split(theory).map((p) => (p.chip ? <mark>{p.t}</mark> : p.t))}</p>}
    </section>

    <section aria-labelledby="work-h">
      <h2 id="work-h">Working on</h2>
      <ul class="cards">
        {featured.map((t) => (
          <li>
            <a href={t.href} class="shot"><img src={`/images/top8/${t.img}.jpg`} width="960" height="600" alt="" /></a>
            <span class="kind">{t.kind}</span>
            <a class="t" href={t.href}>{t.title}</a>
            <p>{t.blurb}</p>
            {t.talk && <a class="talk" href={t.talk.href}>Talk: {t.talk.label}</a>}
          </li>
        ))}
      </ul>
      <p class="more"><a href="/projects">All projects</a> · <a href="/about#talks">Talks</a> · <a href="/cv">CV</a></p>
    </section>
  </main>
  <Im />
)}

{variant === 'b' && (
  <main class="b">
    <h1 class="sr">Shingai Thornton</h1>
    <p class="lede">{parts.map((p) => (p.chip ? <mark>{p.t}</mark> : p.t))}</p>
    <p class="bio">{bio}</p>

    <section aria-labelledby="b-work">
      <h2 id="b-work">Work</h2>
      <ul class="rows">
        {ordered.map((t) => (
          <li>
            <a href={t.href}>{t.title}</a>
            <span class="what">{t.blurb ?? t.note}</span>
          </li>
        ))}
      </ul>
    </section>

    <section aria-labelledby="b-talks">
      <h2 id="b-talks">Talks, 2026</h2>
      <ul class="rows">
        {talks.map((t) => (
          <li>
            <a href={t.href}>{t.title}</a>
            <span class="what">{t.venue}, {t.place}</span>
          </li>
        ))}
      </ul>
    </section>

    <p class="reach"><a href="/cv">CV</a> · <a href={`mailto:${email}`}>Email</a> · <a href={callUrl}>Book 20 minutes</a></p>
  </main>
)}

{variant === 'c' && (
  <main class="c">
    <aside class="side">
      <img class="face" src={icons.headshot.pixel} width="64" height="64" alt="Shingai Thornton" />
      <h1>Hi, I'm Shingai.</h1>
      <p class="lede">{parts.map((p) => (p.chip ? <mark>{p.t}</mark> : p.t))}</p>
      <p class="bio">{bio}</p>
      <p class="reach"><a href="/about">About</a> · <a href="/cv">CV</a> · <a href={callUrl}>Book 20 minutes</a></p>
    </aside>

    <div class="work">
      <ul class="stack">
        {featured.map((t) => (
          <li>
            <a href={t.href} class="shot"><img src={`/images/top8/${t.img}.jpg`} width="960" height="600" alt="" /></a>
            <div>
              <span class="kind">{t.kind}</span>
              <a class="t" href={t.href}>{t.title}</a>
              <p>{t.blurb}</p>
              {t.talk && <a class="talk" href={t.talk.href}>Talk: {t.talk.label}</a>}
            </div>
          </li>
        ))}
      </ul>
      <p class="more"><a href="/projects">All projects</a> · <a href="/about#talks">Talks</a></p>
    </div>
  </main>
  <Im />
)}

<style>
  /* shared pieces */
  .kind { display: block; font: 500 12px var(--mono); color: var(--muted); letter-spacing: 0.04em; text-transform: uppercase; margin-bottom: 2px; }
  .shot { display: block; border: var(--edge); border-radius: 8px; overflow: hidden; }
  .shot img { display: block; width: 100%; height: auto; aspect-ratio: 8 / 5; object-fit: cover; object-position: top; transition: transform 200ms; }
  .shot:hover img { transform: scale(1.02); }
  .t { font: 600 1.25rem var(--serif); color: var(--ink); text-decoration: none; }
  .t:hover { color: var(--accent); text-decoration: underline; }
  .talk { font-size: 0.9rem; }
  .more, .reach { color: var(--muted); font-size: 0.95rem; margin: 0; }
  ul { list-style: none; margin: 0; padding: 0; }
  li { margin: 0; }

  /* a: statement */
  .a { display: grid; grid-template-columns: minmax(0, 1fr); gap: 64px; }
  .a h1 { font: 600 2.4rem/1.1 var(--serif); letter-spacing: -0.015em; margin: 0; }
  .a .lede { font-size: 1.15rem; line-height: 1.75; color: var(--ink-2); margin: 24px 0 0; max-width: 34em; }
  .a h2 { font: 600 1.6rem/1.2 var(--serif); margin: 0 0 20px; }
  .a .cards { display: grid; grid-template-columns: minmax(0, 1fr); gap: 40px; }
  .a .shot { margin-bottom: 14px; }
  .a .cards p { margin: 4px 0 6px; color: var(--ink-2); }
  .a .more { margin-top: 36px; }
  @media (min-width: 700px) { .a .cards { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 28px; } }
  @media (min-width: 900px) {
    .a h1 { font-size: 3.75rem; }
    .a .lede { font-size: 1.35rem; }
  }

  /* b: index */
  .b { max-width: 680px; margin: 0 auto; width: 100%; }
  .b .lede { font-size: 1.3rem; line-height: 1.7; color: var(--ink); margin: 0 0 16px; }
  .b .bio { color: var(--ink-2); margin: 0 0 56px; }
  .b h2 { font: 500 12px var(--mono); color: var(--muted); letter-spacing: 0.04em; text-transform: uppercase; margin: 0; padding-bottom: 8px; border-bottom: var(--edge); }
  .b section { margin-bottom: 48px; }
  .b .rows li { display: grid; grid-template-columns: minmax(0, 1fr); gap: 0; padding: 12px 0; border-bottom: var(--edge); }
  .b .rows a { font-weight: 500; line-height: 1.45; color: var(--ink); text-decoration: none; }
  .b .rows a:hover { color: var(--accent); text-decoration: underline; }
  .b .what { color: var(--muted); font-size: 0.92rem; }
  .b .reach { font-size: 1rem; }
  @media (max-width: 520px) { .b .lede { font-size: 1.15rem; } }

  /* c: profile */
  .c { display: grid; grid-template-columns: minmax(0, 1fr); gap: 56px; }
  .c .face { display: block; width: 96px; height: 96px; image-rendering: pixelated; border-radius: 8px; margin-bottom: 20px; }
  .c h1 { font: 600 2rem/1.15 var(--serif); letter-spacing: -0.01em; margin: 0 0 14px; }
  .c .lede { line-height: 1.8; color: var(--ink); margin: 0 0 12px; }
  .c .bio { color: var(--ink-2); font-size: 0.95rem; margin: 0 0 16px; }
  .c .stack { display: grid; gap: 40px; }
  .c .stack li { display: grid; grid-template-columns: minmax(0, 1fr); gap: 14px; align-items: center; }
  .c .stack p { margin: 4px 0 6px; color: var(--ink-2); }
  .c .more { margin-top: 36px; }
  @media (min-width: 640px) { .c .stack li { grid-template-columns: minmax(0, 3fr) minmax(0, 2fr); gap: 28px; } }
  @media (min-width: 900px) {
    .c { grid-template-columns: 300px minmax(0, 1fr); gap: 72px; align-items: start; }
    .c .side { position: sticky; top: 28px; }
  }
</style>
