---
interface Props {
  id: string;
  title: string;
  meta?: string;
  metaId?: string;
  as?: 'section' | 'aside';
  class?: string;
  closable?: boolean;
}
const { id, title, meta, metaId, as: Tag = 'section', class: cls = '', closable = true } = Astro.props;
---

<Tag id={id} class:list={['win', cls]} data-win={id} data-title={title} aria-labelledby={`${id}-h`}>
  <div class="titlebar">
    <span id={`${id}-h`} class="ttl">{title}</span>
    <span class="right">
      {meta && <span class="meta" id={metaId}>{meta}</span>}
      <span class="ctl">
        <button type="button" data-act="min" aria-label={`Minimize ${title}`} aria-expanded="true">_</button>
        <button type="button" data-act="max" aria-label={`Maximize ${title}`} aria-pressed="false">□</button>
        {closable && <button type="button" data-act="close" aria-label={`Close ${title}`}>×</button>}
      </span>
    </span>
  </div>
  <div class="win-body">
    <slot />
  </div>
</Tag>

<script>
  const KEY = 'win:';
  const store = {
    get(k: string) { try { return localStorage.getItem(KEY + k); } catch { return null; } },
    set(k: string, v: string | null) {
      try { v ? localStorage.setItem(KEY + k, v) : localStorage.removeItem(KEY + k); } catch {}
    },
  };

  const wins = Array.from(document.querySelectorAll<HTMLElement>('[data-win]'));
  let bar = document.getElementById('taskbar');
  if (!bar) {
    bar = document.createElement('nav');
    bar.id = 'taskbar';
    bar.className = 'taskbar';
    bar.setAttribute('aria-label', 'Closed windows');
    document.body.appendChild(bar);
  }
  const taskbar = bar;

  function button(w: HTMLElement, act: string) {
    return w.querySelector<HTMLButtonElement>(`:scope > .titlebar [data-act="${act}"]`)!;
  }

  function setState(w: HTMLElement, state: string | null) {
    const id = w.dataset.win!;
    if (state) w.dataset.state = state; else delete w.dataset.state;
    button(w, 'min').setAttribute('aria-expanded', state === 'min' ? 'false' : 'true');
    button(w, 'max').setAttribute('aria-pressed', state === 'max' ? 'true' : 'false');
    document.documentElement.classList.toggle('has-max', !!document.querySelector('[data-win][data-state="max"]'));
    if (state !== 'max') store.set(id, state);
    renderTaskbar();
  }

  function renderTaskbar() {
    const closed = wins.filter((w) => w.dataset.state === 'closed');
    taskbar.replaceChildren(
      ...closed.map((w) => {
        const b = document.createElement('button');
        b.type = 'button';
        b.textContent = '▢ ' + w.dataset.title;
        b.setAttribute('aria-label', 'Reopen ' + w.dataset.title);
        b.addEventListener('click', () => {
          setState(w, null);
          w.querySelector<HTMLButtonElement>('[data-act="close"]')!.focus();
        });
        return b;
      }),
    );
    taskbar.hidden = closed.length === 0;
  }

  for (const w of wins) {
    const saved = store.get(w.dataset.win!);
    const closable = !!w.querySelector(':scope > .titlebar [data-act="close"]');
    if (saved === 'min' || (saved === 'closed' && closable)) w.dataset.state = saved;
    w.querySelector(':scope > .titlebar')!.addEventListener('click', (e) => {
      const act = (e.target as HTMLElement).closest('button')?.dataset.act;
      if (!act) return;
      const cur = w.dataset.state;
      if (act === 'close') {
        setState(w, 'closed');
        (taskbar.lastElementChild as HTMLElement | null)?.focus();
      } else setState(w, cur === act ? null : act);
    });
    w.querySelector(':scope > .titlebar')!.addEventListener('dblclick', (e) => {
      if ((e.target as HTMLElement).closest('button')) return;
      setState(w, w.dataset.state === 'min' ? null : 'min');
    });
  }
  for (const w of wins) setState(w, w.dataset.state ?? null);

  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape') return;
    const m = document.querySelector<HTMLElement>('[data-win][data-state="max"]');
    if (m) { setState(m, null); button(m, 'max').focus(); }
  });
</script>

<style>
  .win { background: var(--panel, #fff); border: 1px solid var(--rule, #1e293b); box-shadow: 2px 2px 0 rgb(30 41 59 / 0.18); overflow: hidden; }
  .titlebar { display: flex; justify-content: space-between; align-items: center; gap: 12px; padding: 4px 6px 4px 12px; background: var(--title, linear-gradient(90deg, #0a3d91, #1a73e8)); color: #fff; font: 600 13px/1.4 var(--mono, monospace); user-select: none; }
  .ttl { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .right { display: flex; align-items: center; gap: 10px; flex: none; }
  .ctl { display: flex; gap: 3px; }
  .ctl button { width: 20px; height: 18px; padding: 0; display: grid; place-items: center; font: 600 11px/1 var(--mono, monospace); color: #0f172a; background: #e8eef7; border: 1px solid #fff; border-right-color: #0f172a; border-bottom-color: #0f172a; cursor: pointer; }
  .ctl button:hover { background: #fff; }
  .ctl button:active { border-color: #0f172a #fff #fff #0f172a; }
  .ctl button:focus-visible { outline: 2px solid var(--yellow, #ffd60a); outline-offset: 1px; }
  .ctl [data-act='close']:hover { background: #e81123; color: #fff; }

  .win[data-state='min'] > .win-body { display: none; }
  .win[data-state='min'] { align-self: start; }
  .win[data-state='closed'] { display: none; }
  .win[data-state='max'] { position: fixed; inset: 16px; z-index: 50; display: flex; flex-direction: column; box-shadow: 0 0 0 100vmax rgb(15 23 42 / 0.45), 0 12px 40px rgb(15 23 42 / 0.35); }
  .win[data-state='max'] > .win-body { flex: 1; overflow: auto; }
  :global(html.has-max) { overflow: hidden; }

  :global(.taskbar) { position: fixed; left: 16px; bottom: 0; right: 180px; z-index: 40; display: flex; flex-wrap: wrap; gap: 4px; }
  :global(.taskbar[hidden]) { display: none; }
  :global(.taskbar button) { font: 600 13px var(--mono, monospace); color: #0f172a; background: #e8eef7; border: 1px solid #0f172a; border-bottom: 0; padding: 6px 12px; cursor: pointer; max-width: 220px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  :global(.taskbar button:hover) { background: var(--yellow, #ffd60a); }
</style>
