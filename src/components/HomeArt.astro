---
// The drawing in the middle of home. Hairline SVG in the page's own colors; decorative, so hidden from screen readers.
//   system:  a bounded system: flow comes in from a source, moves between three parts, leaves to a sink
//   lattice: a field of dots with one small network lit up in it
//   nested:  a system of systems: boundaries inside a boundary
// Only `variant` is drawn; while choosing, home can show any one via ?art= (see index.astro).
interface Props {
  variant: 'system' | 'lattice' | 'nested';
}
const { variant } = Astro.props;

// lattice: a 10×6 grid, with a few points joined into a small network
const cols = 10, rows = 6, gap = 32, ox = 16, oy = 40;
const pt = (c: number, r: number) => [ox + c * gap, oy + r * gap] as const;
const lit: [number, number][] = [[3, 1], [5, 2], [4, 4], [6, 4], [7, 1], [2, 3]];
const edges: [number, number][] = [[0, 1], [1, 2], [1, 3], [1, 4], [2, 5], [0, 5], [3, 4]];
---

<svg class="art" data-variant={variant} viewBox="0 0 320 240" aria-hidden="true" focusable="false">
  {variant === 'system' && (
    <g fill="none" stroke-linecap="round" stroke-linejoin="round">
      <circle cx="160" cy="120" r="82" class="edge" />
      <rect x="14" y="108" width="24" height="24" rx="2" class="edge" />
      <rect x="282" y="108" width="24" height="24" rx="2" class="edge" />
      <path d="M38 120 H78" class="flow" />
      <path d="M242 120 H282" class="flow" />
      <path d="M78 120 L128 92 L192 92 L208 148 L144 152 L128 92" class="flow inner" />
      <path d="M208 148 L242 120" class="flow inner" />
      <rect x="74" y="116" width="8" height="8" class="port" />
      <rect x="238" y="116" width="8" height="8" class="port" />
      <circle cx="128" cy="92" r="9" class="node" />
      <circle cx="192" cy="92" r="9" class="node" />
      <circle cx="208" cy="148" r="9" class="node" />
      <circle cx="144" cy="152" r="9" class="node" />
    </g>
  )}

  {variant === 'lattice' && (
    <g>
      {Array.from({ length: cols * rows }, (_, i) => {
        const [x, y] = pt(i % cols, Math.floor(i / cols));
        return <circle cx={x} cy={y} r="1.6" class="dot" />;
      })}
      {edges.map(([a, b]) => {
        const [x1, y1] = pt(...lit[a]);
        const [x2, y2] = pt(...lit[b]);
        return <line x1={x1} y1={y1} x2={x2} y2={y2} class="link" />;
      })}
      {lit.map(([c, r], i) => {
        const [x, y] = pt(c, r);
        return <circle cx={x} cy={y} r={i === 1 ? 7 : 4.5} class="hub" />;
      })}
    </g>
  )}

  {variant === 'nested' && (
    <g fill="none">
      <circle cx="160" cy="120" r="100" class="edge" />
      <circle cx="118" cy="96" r="38" class="edge" />
      <circle cx="204" cy="100" r="32" class="edge" />
      <circle cx="160" cy="170" r="30" class="edge" />
      <circle cx="104" cy="88" r="5" class="node" /><circle cx="130" cy="106" r="5" class="node" /><circle cx="114" cy="116" r="3.5" class="node" />
      <circle cx="196" cy="94" r="5" class="node" /><circle cx="214" cy="110" r="3.5" class="node" />
      <circle cx="150" cy="166" r="3.5" class="node" /><circle cx="170" cy="176" r="5" class="node" />
      <path d="M150 124 Q160 140 156 146 M178 120 Q174 140 168 146 M156 102 H172" class="flow" />
    </g>
  )}
</svg>

<style>
  .art { display: block; width: 100%; max-width: 360px; height: auto; overflow: visible; }
  .edge { stroke: var(--ink-2); stroke-width: 1.25; fill: none; }
  .flow { stroke: var(--accent); stroke-width: 1.5; fill: none; stroke-dasharray: 4 5; }
  .inner { opacity: 0.75; }
  .port { fill: var(--page); stroke: var(--ink-2); stroke-width: 1.25; }
  .node { fill: var(--paper); stroke: var(--accent); stroke-width: 1.5; }
  .dot { fill: var(--muted); opacity: 0.45; }
  .link { stroke: var(--accent); stroke-width: 1.25; }
  .hub { fill: var(--paper); stroke: var(--accent); stroke-width: 1.5; }

  /* the flow drifts slowly, unless the reader has asked for less motion */
  @media (prefers-reduced-motion: no-preference) {
    .flow { animation: drift 2.4s linear infinite; }
  }
  @keyframes drift { to { stroke-dashoffset: -18; } }
</style>
